{
  "name": "emberdeep",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Emberdeep 余烬深渊 — 一款纯 TypeScript + Canvas 的浏览器 Roguelike",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
